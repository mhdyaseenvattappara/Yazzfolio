rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin(uid) {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_uids/$(request.auth.uid));
    }

    // --- Collection Rules ---

    // Admin UIDs collection (Internal Role Management)
    match /admin_uids/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // Only manageable via Firebase Console
    }

    // Project Likes (Public Engagement)
    match /project_likes/{likeId} {
      allow read, create, delete: if true;
    }

    // Main Portfolio Data Structure
    match /admin_users/{uid} {
      allow read: if true;
      allow write: if isAdmin(uid);

      match /portfolio_items/{id} {
        allow read: if true;
        allow write: if isAdmin(uid);
      }
      match /services/{id} {
        allow read: if true;
        allow write: if isAdmin(uid);
      }
      match /testimonials/{id} {
        allow read: if true;
        allow write: if isAdmin(uid);
      }
      match /timeline_events/{id} {
        allow read: if true;
        allow write: if isAdmin(uid);
      }
      match /tools/{id} {
        allow read: if true;
        allow write: if isAdmin(uid);
      }
      match /videos/{id} {
        allow read: if true;
        allow write: if isAdmin(uid);
      }
      match /invoices/{id} {
        allow read: if true; // Public access for client links
        allow write: if isAdmin(uid);
      }
      match /contact_messages/{id} {
        allow create: if true;
        allow read, update, delete: if isAdmin(uid);
      }
    }

    // Flat structure support (Legacy/Compatibility)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isSignedIn() && exists(/databases/$(database)/documents/admin_uids/$(request.auth.uid));
    }
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isSignedIn() && exists(/databases/$(database)/documents/admin_uids/$(request.auth.uid));
    }
  }
}